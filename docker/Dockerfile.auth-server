# syntax=docker/dockerfile:1
#
# Production auth-server image (compiled NestJS + BetterAuth).
# Build from repo root:
#   docker build -f docker/Dockerfile.auth-server -t sassy-auth-server .
#
# Requires DATABASE_URL, RSA keys, BETTER_AUTH_SECRET, and URL env vars at runtime.
# See DEPLOYMENT.md.

FROM node:24-bookworm-slim AS base

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/auth-server/package.json apps/auth-server/
COPY packages/db/package.json packages/db/
COPY packages/db/schema.prisma packages/db/
COPY packages/db/prisma.config.ts packages/db/
COPY packages/db/migrations packages/db/migrations
COPY packages/db/tsconfig.json packages/db/
COPY packages/types/package.json packages/types/
COPY packages/types/tsconfig.json packages/types/
COPY packages/telemetry/package.json packages/telemetry/
COPY packages/telemetry/tsconfig.json packages/telemetry/

ARG DATABASE_URL="postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder"

RUN pnpm install --frozen-lockfile

# ── Build ─────────────────────────────────────────────────────────────────────
FROM deps AS build

COPY apps/auth-server apps/auth-server
COPY packages/db packages/db
COPY packages/types packages/types
COPY packages/telemetry packages/telemetry

RUN pnpm --filter @sassy-auth/db --filter @sassy-auth/types --filter @sassy-auth/telemetry build \
 && pnpm --filter @sassy-auth/auth-server build

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM base AS runner

ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/apps/auth-server/dist ./apps/auth-server/dist
COPY --from=build /app/apps/auth-server/package.json ./apps/auth-server/package.json
# pnpm's isolated node_modules only hoists root-level deps to /app/node_modules;
# package-specific deps (e.g. dotenv) live as symlinks under the package's own
# node_modules, which must be copied too or `require()` fails at runtime.
COPY --from=build /app/apps/auth-server/node_modules ./apps/auth-server/node_modules
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/packages/types/dist ./packages/types/dist
COPY --from=build /app/packages/types/package.json ./packages/types/package.json
COPY --from=build /app/packages/telemetry/dist ./packages/telemetry/dist
COPY --from=build /app/packages/telemetry/package.json ./packages/telemetry/package.json
COPY --from=build /app/packages/telemetry/node_modules ./packages/telemetry/node_modules

COPY docker/entrypoint-auth-server-prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3010

ENTRYPOINT ["/entrypoint.sh"]
