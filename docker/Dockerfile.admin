# syntax=docker/dockerfile:1
#
# Production admin console image (compiled Next.js).
# Build from repo root:
#   docker build -f docker/Dockerfile.admin -t sassy-auth-admin .
#
# See DEPLOYMENT.md for required environment variables.

FROM node:24-bookworm-slim AS base

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/admin/package.json apps/admin/
COPY packages/ui/package.json packages/ui/
COPY packages/ui/tsconfig.json packages/ui/
COPY packages/ui/src packages/ui/src
COPY packages/ui/globals.css packages/ui/
COPY packages/ui/tailwind.config.ts packages/ui/
COPY packages/telemetry/package.json packages/telemetry/
COPY packages/telemetry/tsconfig.json packages/telemetry/
COPY packages/types/package.json packages/types/
COPY packages/types/tsconfig.json packages/types/

RUN pnpm install --frozen-lockfile

# ── Build ─────────────────────────────────────────────────────────────────────
FROM deps AS build

COPY apps/admin apps/admin
COPY packages/ui packages/ui
COPY packages/telemetry packages/telemetry
COPY packages/types packages/types

RUN pnpm --filter @sassy-auth/telemetry --filter @sassy-auth/types build

# Next.js inlines NEXT_PUBLIC_* at build time when present.
ARG NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=""
ARG NEXT_PUBLIC_SENTRY_DSN=""
ARG NEXT_PUBLIC_AUTH_SERVER_URL=""
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

ENV NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=$NEXT_PUBLIC_ADMIN_CONTACT_EMAIL
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_AUTH_SERVER_URL=$NEXT_PUBLIC_AUTH_SERVER_URL
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY

RUN pnpm --filter @sassy-auth/admin build

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM base AS runner

ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/apps/admin/.next ./apps/admin/.next
COPY --from=build /app/apps/admin/package.json ./apps/admin/package.json
COPY --from=build /app/apps/admin/next.config.ts ./apps/admin/next.config.ts
COPY --from=build /app/apps/admin/lib ./apps/admin/lib
COPY --from=build /app/apps/admin/i18n ./apps/admin/i18n
COPY --from=build /app/apps/admin/messages ./apps/admin/messages
COPY --from=build /app/apps/admin/middleware.ts ./apps/admin/middleware.ts
COPY --from=build /app/apps/admin/instrumentation.ts ./apps/admin/instrumentation.ts
COPY --from=build /app/apps/admin/instrumentation-client.ts ./apps/admin/instrumentation-client.ts
COPY --from=build /app/apps/admin/sentry.server.config.ts ./apps/admin/sentry.server.config.ts
COPY --from=build /app/apps/admin/sentry.edge.config.ts ./apps/admin/sentry.edge.config.ts
COPY --from=build /app/packages/ui ./packages/ui
COPY --from=build /app/packages/telemetry/dist ./packages/telemetry/dist
COPY --from=build /app/packages/telemetry/package.json ./packages/telemetry/package.json
COPY --from=build /app/packages/telemetry/node_modules ./packages/telemetry/node_modules
# pnpm's isolated node_modules only hoists root-level deps to /app/node_modules;
# package-specific deps (next's own bin, react, react-dom, dotenv, ...) live as
# symlinks under apps/admin/node_modules, which must be copied too or `npx next
# start` silently fetches a mismatched `next` from the registry instead.
COPY --from=build /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=build /app/packages/types/dist ./packages/types/dist
COPY --from=build /app/packages/types/package.json ./packages/types/package.json

WORKDIR /app/apps/admin

EXPOSE 3001

CMD ["sh", "-c", "npx next start -p ${PORT:-3001}"]
