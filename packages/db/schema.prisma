generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── BetterAuth tables (managed by BetterAuth Prisma adapter) ──────────────────

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  twoFactorEnabled Boolean     @default(false)
  sessions         Session[]
  accounts         Account[]
  saUser           SaUser?
  twoFactor        TwoFactor?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // bug-0179: BetterAuth's session middleware runs
  // `Session.findFirst({ where: { userId } })` on every authenticated
  // request. Without this index the DB falls back to a sequential
  // scan whose cost grows with total session-row count across all
  // users. The unique index on `token` above supports the sign-in
  // path, but the userId lookup is the hot per-request query.
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  // bug-0179: BetterAuth loads the credential account by userId at
  // password-verification time (`Account.findFirst({ where: { userId } })`).
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  // bug-0179: BetterAuth's magic-link and email-OTP flows lookup by
  // identifier (`Verification.findFirst({ where: { identifier } })`).
  @@index([identifier])
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)
}

// ── SassyAuth tables ──────────────────────────────────────────────────────────

enum UserStatus {
  active
  pending
  inactive
}

model SaApp {
  id          Int            @id @default(autoincrement())
  publicId    String         @unique
  name        String         @unique
  url         String
  callbackUrl        String?
  twoFactorTrustDays Int?
  isPlatform         Boolean        @default(false)
  orgs        SaOrg[]
  permissions SaPermission[]
  roles       SaRole[]
}

model SaOrg {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique
  name       String
  appId      Int
  app        SaApp    @relation(fields: [appId], references: [id])
  isPlatform Boolean  @default(false)
  users      SaUser[]

  @@unique([appId, name])
}

model SaUser {
  id               Int                @id @default(autoincrement())
  publicId         String             @unique
  betterAuthUserId String             @unique
  betterAuthUser   User               @relation(fields: [betterAuthUserId], references: [id])
  orgId            Int
  org              SaOrg              @relation(fields: [orgId], references: [id])
  firstName        String
  lastName         String
  // bug-0147: partial-unique semantics. Both fields are nullable so
  // multiple NULL rows coexist (Postgres treats NULLs as distinct in a
  // standard unique index — CREATE UNIQUE INDEX on a nullable column
  // enforces uniqueness across NON-NULL values only), and non-NULL
  // values are enforced unique across the whole table. This lets
  // `directLogin` do `findUnique({ where: { username } })` /
  // `findUnique({ where: { phoneNumber } })` without collisions across
  // orgs (was `findFirst` → returned an arbitrary matching row → cross-
  // tenant auth bug).
  phoneNumber      String?            @unique
  username         String?            @unique
  status           UserStatus         @default(pending)
  // bug-0186: `createdAt` records when the admin provisioned the user
  // (or when they self-registered), NOT when the BetterAuth `User`
  // row was created — those diverge for platform admins seeded before
  // this column existed (backfilled with the migration's default) and
  // for BetterAuth users that lose their SaUser via bug-0151. This is
  // the field the /users admin table's "Created" column reads.
  createdAt        DateTime           @default(now())
  // `lastLoginAt` is denormalized and updated on every login-shaped
  // event: BetterAuth `sign-in/*` (via a databaseHooks.session.create
  // hook in auth.config.ts) and `POST /api/token/direct/login` (in
  // token.controller.ts, on successful JWT issuance). Null means the
  // user has never signed in — most commonly a pending invitee.
  lastLoginAt           DateTime?
  twoFactorPromptedAt   DateTime?
  roles            SaUserRole[]
  directPermissions SaUserPermission[]
  invitations       SaInvitation[]

  @@index([orgId])
}

model SaInvitation {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique
  token     String    @unique
  userId    Int
  user      SaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // bug-0187: `@@index([token])` dropped — `token String @unique`
  // above already provisions a btree unique index, so a second
  // non-unique index on the same column was pure overhead.
  @@index([userId])
  // bug-0144: invitations are queried by `expiresAt` in two spots —
  // `validateToken` compares against now(), and any cleanup job
  // scanning for expired unused tokens would filter on the same
  // column. A supporting index keeps both cheap as the table grows.
  @@index([expiresAt])
}

model SaPermission {
  id       Int                @id @default(autoincrement())
  publicId String             @unique
  name     String             @unique
  appId    Int
  isSystem Boolean            @default(false)
  app      SaApp              @relation(fields: [appId], references: [id])
  roles    SaRolePermission[]
  users    SaUserPermission[]

  @@index([appId])
}

model SaRole {
  id          Int                @id @default(autoincrement())
  publicId    String             @unique
  name        String
  appId       Int
  app         SaApp              @relation(fields: [appId], references: [id])
  permissions SaRolePermission[]
  users       SaUserRole[]

  @@unique([appId, name])
  @@index([appId])
}

model SaRolePermission {
  roleId       Int
  permissionId Int
  role         SaRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   SaPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SaUserRole {
  userId Int
  roleId Int
  user   SaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   SaRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SaUserPermission {
  userId       Int
  permissionId Int
  user         SaUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   SaPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// bug-0039: OAuth authorization codes moved from an in-memory Map on a
// single OauthService instance to a shared DB table so the auth-server
// can run multiple replicas behind a load balancer. Codes are one-shot:
// generated at /api/token/oauth/authorize and deleted on /api/token/oauth/token
// (or on any validation failure — see OauthService.exchangeCode). The
// row also carries the fields bound at issuance for PKCE + redirect_uri
// verification per RFC 6749 §4.1.3 (bug-0054). Rows accumulate past
// `expiresAt` but the exchange path rejects them, so a periodic cleanup
// job is optional (not shipped in v1).
model SaOauthCode {
  code                String   @id
  userId              String
  appPublicId         String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([expiresAt])
}
