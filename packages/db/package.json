{
  "name": "@sassy-auth/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "jest",
    "postinstall": "prisma generate",
    "db:generate": "dotenv -e ../../.env.local -- prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env.local -- prisma db push",
    "db:seed": "dotenv -e ../../.env.local -- ts-node --transpile-only -r tsconfig-paths/register ../../apps/auth-server/src/seed/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.1.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0"
  }
}
