{
  "name": "@sassy-auth/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "db:generate": "dotenv -e ../../.env.local -- prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env.local -- prisma db push",
    "db:seed": "dotenv -e ../../.env.local -- ts-node --transpile-only -r tsconfig-paths/register ../../apps/auth-server/src/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0"
  }
}
