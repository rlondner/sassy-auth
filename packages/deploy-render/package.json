{
  "name": "@sassy-auth/deploy-render",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "deploy": "ts-node --transpile-only src/cli.ts"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.7.13",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
