{
  "moduleFileExtensions": ["js", "mjs", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(\\.e2e-spec\\.ts|(scenarios|migrations)/.*\\.spec\\.ts)$",
  "transform": {
    "^.+\\.(t|j|mj)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(better-auth|better-call|@better-auth|@better-fetch|@noble|defu|jose|kysely|nanostores|rou3|set-cookie-parser|nanoid|uint8array-extras|uuid))"
  ],
  "testTimeout": 30000
}
