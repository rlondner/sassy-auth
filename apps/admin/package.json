{
  "name": "@sassy-auth/admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "test": "node ../../scripts/log-test.mjs admin jest",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@sassy-auth/ui": "workspace:*",
    "@sentry/nextjs": "^10.54.0",
    "@tanstack/react-table": "^8.20.0",
    "lucide-react": "^0.577.0",
    "next": "^15.0.0",
    "next-intl": "^3.26.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sonner": "^1.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@sassy-auth/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^server-only$": "<rootDir>/__mocks__/server-only.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@sassy-auth)/)"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "jsx": "react-jsx"
        }
      }
    }
  }
}
